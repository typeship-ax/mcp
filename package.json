{
  "name": "typeship-mcp",
  "version": "1.0.0",
  "description": "MCP server for typeship. Generated by typeship.",
  "keywords": [
    "typeship",
    "api",
    "typescript",
    "openapi",
    "mcp",
    "mcp-server",
    "typed"
  ],
  "homepage": "https://typeship.dev",
