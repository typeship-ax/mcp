{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.typeship/typeship",
  "title": "Typeship",
  "description": "MCP server for Typeship.",
  "websiteUrl": "https://typeship.dev",
  "repository": {
    "url": "https://github.com/typeship-ax/mcp",
    "source": "github"
  },
  "version": "0.24.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://typeship.dev/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://typeship.dev/mcp/readonly"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@typeship-ax/mcp",
      "version": "0.24.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "environmentVariables": [
        {
          "name": "TYPESHIP_TOKEN",
          "description": "Typeship token, sent as Authorization: Bearer.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
